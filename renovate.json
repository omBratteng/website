{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixChore",
    ":ignoreModulesAndTests",
    ":prHourlyLimitNone",
    ":enablePreCommit",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "1 day",
  "schedule": [
	"before 4am on Monday"
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "groupName": "npm",
      "automerge": true
    },
    {
      "matchDatasources": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm-dev",
      "automerge": true
    }
  ]
}
